          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="may emit 0..N domain events" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;startArrow=none;" edge="1" parent="1" source="WebhookEvent" target="OutboxEvent">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="0..N async consumers/jobs" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;startArrow=none;" edge="1" parent="1" source="OutboxEvent" target="BackgroundJob">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="1 : N executions" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;startArrow=none;" edge="1" parent="1" source="ScheduledJob" target="BackgroundJob">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="0..N rules contribute" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;startArrow=none;" edge="1" parent="1" source="TaxRule" target="Invoice">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" value="used for duplicate protection" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;startArrow=none;" edge="1" parent="1" source="IdempotencyRecord" target="WebhookEvent">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note1" value="&lt;b&gt;Cross-page relations:&lt;/b&gt;&lt;br&gt;Warehouse.seller_id → Seller (Page 03); WarehouseStock.offer_id → SellerOffer (Page 03). MediaLink.owner_type/owner_id may attach MediaAsset to Product/ProductVariant/Seller/Review/ReturnRequest/Article without duplicating file tables. SellerStatusHistory.seller_id → Seller and actor_id → User. Invoice.order_id → Order (Page 04). WebhookEvent is mainly used by Payment/Refund integrations (Page 05). IdempotencyRecord protects checkout/payment/refund/wallet and other sensitive mutations. TaxRule/Invoice are optional and enabled only when business requirements require tax/invoicing." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="1400" width="1750" height="150" as="geometry" />
        </mxCell>
        <mxCell id="note2" value="&lt;b&gt;M:N modeling rule:&lt;/b&gt; all many-to-many relationships are represented through explicit join entities where the relationship carries business data (e.g. SellerOffer, ProductAttributeValue, CartItem, OrderItem, SettlementItem, WishlistItem, ReviewVote, ArticleTag, WarehouseStock)." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="1580" width="1750" height="90" as="geometry" />
        </mxCell>
      </root>
